{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuxNotes",
  "mainBinaryName": "tuxnotes",
  "version": "0.1.0",
  "identifier": "io.github.tuxnotes.TuxNotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TuxNotes",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Open notes for Linux",
    "longDescription": "TuxNotes is a lightweight, local-first notes app for Linux with a clean three-pane design, rich text, checklists, fast search and Google Drive backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
